# ==============================================================================
# AegisForge-AI .gitignore
# ==============================================================================

# ── Python bytecode & caches ──
__pycache__/
*.py[codz]
*$py.class
*.so

# ── Environment & secrets ──
.env
.envrc
.venv/
env/
venv/
ENV/

# ── Distribution & packaging ──
.Python
build/
dist/
*.egg-info/
*.egg
MANIFEST
wheels/
sdist/

# ── PyInstaller ──
*.manifest
*.spec

# ── Installer logs ──
pip-log.txt
pip-delete-this-directory.txt

# ── Testing & coverage ──
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/

# ── Type checkers & linters ──
.mypy_cache/
.dmypy.json
.ruff_cache/

# ── Jupyter / IPython ──
.ipynb_checkpoints

# ── IDE & editors ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Operating system files ──
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Temporary & log files ──
*.log
*.tmp
*.temp
/tmp/
tempCodeRunnerFile.py

# ── Streamlit ──
.streamlit/secrets.toml

# ==============================================================================
# AegisForge-AI: Runtime Data Directories
# ==============================================================================
data/output/*
!data/output/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/scratch/*
!data/scratch/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/vector_storage/qdrant_db/
data/vector_storage/extracted_images/
!data/vector_storage/.gitkeep
data/audit.db

# ==============================================================================
# AegisForge-AI: Model Pool Storage (Self-Contained Weights & Blobs)
# ==============================================================================
model_pool/easyocr/*
model_pool/ollama/*
model_pool/downloads/*
model_pool/models/*
!model_pool/**/.gitkeep

# ── Explicit model weight formats ──
*.pth
*.pt
*.bin
*.safetensors
*.gguf
*.onnx
*.weights
*.ckpt

# ── Ollama local cache & installers ──
.ollama/
OllamaSetup.exe

# ==============================================================================
# Safety: Never ignore source code and docs
# ==============================================================================
!*.py
!*.md
!*.bat
!*.ps1
!*.sh

# Explicitly ignore runtime generated data regardless of file extension
data/output/*
!data/output/.gitkeep
data/logs/*
!data/logs/.gitkeep
data/scratch/*
!data/scratch/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/vector_storage/qdrant_db/
data/vector_storage/extracted_images/
!data/vector_storage/.gitkeep




# Test artifacts
mock_inspection.pdf
*.pdf
